FROM python:3.12-slim

# 安装系统依赖（QR 解码）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libzbar0 git \
    && rm -rf /var/lib/apt/lists/*

# 克隆仓库并安装
RUN git clone https://github.com/l41036406-del/xmu-rollcall-wechat-bot.git /app
WORKDIR /app
RUN pip install --no-cache-dir -e xmu-rollcall-cli/ && \
    pip install -U xmulogin

# 创建数据目录
RUN mkdir -p /root/.xmu_rollcall

# 默认启动（首次登录完成后，用这个启动机器人）
CMD ["python", "-m", "xmu_rollcall.wechat_bot"]
